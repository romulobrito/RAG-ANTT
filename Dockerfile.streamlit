# Tela de QA. Reusa a imagem da API para o facade nao divergir.
# Construir a API antes:
#   docker build -f Dockerfile.api -t rag-antt-api:local .

FROM rag-antt-api:local

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health')"

CMD ["streamlit", "run", "antt_rag_unified.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
