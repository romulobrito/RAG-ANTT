# Copie as linhas que faltarem para o .env. Nao commite o .env.
# A chave real nunca entra no git. "trocar" so marca o lugar.
RAG_API_KEY=trocar

# O compose grava estas no container. O .env pode trocar o modelo.
# Notebook: llama3.2:3b. Host com RAM (~8-10 GiB livres): qwen2.5:7b
# e, no container do Ollama, ollama pull qwen2.5:7b.
RAG_LLM_MODEL=llama3.2:3b

# Dentro do container o compose usa http://ollama:11434/v1.
# Nao use localhost: a porta 11434 nao e publicada no host.
OLLAMA_BASE_URL=http://ollama:11434/v1

RAG_LLM_ALLOWED_PROVIDERS=ollama
# Quando a Agencia liberar a nuvem, preencha a chave no .env e use:
# RAG_LLM_ALLOWED_PROVIDERS=ollama,deepseek
# OPENROUTER_API_KEY=
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=4096
RAG_MAX_DOCUMENTOS=30
RAG_EMBEDDING_ALLOWED=local
RAG_EMBEDDING_PROVIDER=local
RAG_INCREMENTAL_UPLOAD_ENABLED=true
RAG_UPLOAD_FORMATS=pdf,docx,xlsx
RAG_UPLOAD_MAX_BYTES=52428800
RAG_INBOX_SCAN_ENABLED=true
RAG_INBOX_SCAN_SECONDS=30
RAG_INBOX_FORMATS=pdf
# Opcional. Quando preenchida, protege a reindexacao completa.
RAG_OPS_API_KEY=
RAG_VAGAS_GERACAO_LOCAL=1
RAG_HISTORICO_TURNOS=10
RAG_HISTORICO_REESCRITA=8
RAG_HISTORICO_CHARS_RESPOSTA=1000
RAG_LLM_CLOUD_FALLBACK=false
RAG_SWAGGER=true
RAG_OLLAMA_TIMEOUT=900
